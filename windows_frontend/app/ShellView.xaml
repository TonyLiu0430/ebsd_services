<UserControl
    x:Class="EBSDDesktop.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <Grid x:Name="Root" Loaded="Root_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="EBSD Desktop" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="準備開啟…" VerticalAlignment="Center" />
            <Button x:Name="ReloadButton" Grid.Column="2" Content="重新載入" Click="Reload_Click" IsEnabled="False" />
            <Button Grid.Column="3" Content="資料資料夾" Click="Data_Click" />
        </Grid>
        <WebView2 x:Name="Browser" Grid.Row="1" Visibility="Collapsed" />
        <StackPanel x:Name="StartupPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="680" Margin="32">
            <ProgressRing x:Name="BusyRing" IsActive="True" Width="40" Height="40" />
            <TextBlock x:Name="StartupText" Text="正在啟動本機分析服務…" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
    </Grid>
</UserControl>
